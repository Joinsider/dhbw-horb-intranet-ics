# Key that clients pass as ?api_key=... (alternatively API_KEY_FILE=/run/secrets/api_key)
API_KEY=

# Intranet login of the DHBW Horb (alternatively INTRANET_USER_FILE / INTRANET_PASSWORD_FILE)
INTRANET_USER=
INTRANET_PASSWORD=

# Course as shown in the timetable dropdown (INF2024) or as intranet ID (HOR-TINF2024)
KURS=INF2024

# Number of weeks to fetch in addition to the current week
WEEKS_AHEAD=4

# Optional tuning (defaults shown)
#CACHE_TTL_SECONDS=3600
#MIN_FETCH_INTERVAL_SECONDS=300
#REQUEST_DELAY_SECONDS=2
#DB_PATH=/data/schedule.db
